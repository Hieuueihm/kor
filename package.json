{
  "name": "haru-korean",
  "version": "0.5.0",
  "private": true,
  "description": "Haru — học tiếng Hàn từ video YouTube trên Windows",
  "author": "Haru",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/electron-smoke.mjs",
    "dist": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "docx": "^9.15.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "youtube-transcript-plus": "2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "vn.haru.korean",
    "productName": "Haru",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/haru.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Haru-${version}-Windows.exe"
    }
  }
}
